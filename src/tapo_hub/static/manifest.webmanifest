{
  "id": "/",
  "name": "Tapo Hub Reader",
  "short_name": "Tapo Reader",
  "description": "A local dashboard for sensors connected to your Tapo H100.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0c1220",
